# syntax=docker/dockerfile:1
ARG BASE_IMAGE=ghcr.io/agentserver/botmux:master
FROM ${BASE_IMAGE}

USER root
ARG TARGETARCH
ARG BYTEDCLI_VERSION=latest
ARG LARK_CLI_VERSION=latest

# BVC 当前发布包仅支持 linux/amd64。
RUN test "$TARGETARCH" = amd64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends bash curl \
    && rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    curl -fsSL --connect-timeout 5 --max-time 120 \
      'http://luban-source.byted.org/repository/scm/api/v1/download_latest/?name=tao/modules/bvc' \
      -o /tmp/bvc.tar.gz; \
    mkdir -p /opt/bvc; \
    tar -xzf /tmp/bvc.tar.gz -C /opt/bvc; \
    rm /tmp/bvc.tar.gz; \
    ln -s /opt/bvc/bin/bvc /usr/local/bin/bvc; \
    ln -s /home/botmux/.local/bin/bkectl /usr/local/bin/bkectl

RUN NPM_CONFIG_REGISTRY=http://bnpm.byted.org npm install -g \
      "@bytedance-dev/bytedcli@${BYTEDCLI_VERSION}" \
      "@larksuite/cli@${LARK_CLI_VERSION}" \
    && lark-cli --version \
    && bytedcli --version \
    && npm cache clean --force

# 以运行用户安装，保留 ~/.local 下的产物和更新权限。
USER node
RUN bash -c 'set -euo pipefail; \
    script="$(curl -fsSL --connect-timeout 2 --max-time 6 "https://gd2o4mok.china-north-dt-fn.bytedance.net/scripts/bkectl_install.sh")"; \
    bash <<<"$script"'

RUN --network=none command -v bkectl && BKECTL_DISABLE_AUTO_UPDATE=1 bkectl version \
    && command -v bytedcli && bytedcli --version \
    && command -v lark-cli && lark-cli --version

# syntax=docker/dockerfile:1
ARG BASE_IMAGE=ghcr.io/agentserver/botmux:master
FROM ${BASE_IMAGE}

USER root
ARG TARGETARCH
ARG BYTEDCLI_VERSION=latest
ARG LARK_CLI_VERSION=latest

# BVC 当前发布包仅支持 linux/amd64；bkectl 从 sre/tce/srectl 获取。
RUN test "$TARGETARCH" = amd64 \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash krb5-user libgssapi-krb5-2 openssh-client \
    && rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    curl -fsSL --connect-timeout 5 --max-time 120 \
      'http://luban-source.byted.org/repository/scm/api/v1/download_latest/?name=tao/modules/bvc' \
      -o /tmp/bvc.tar.gz; \
    mkdir -p /opt/bvc; \
    tar -xzf /tmp/bvc.tar.gz -C /opt/bvc; \
    rm /tmp/bvc.tar.gz; \
    install -m 0755 /opt/bvc/bin/bvc /usr/local/bin/bvc

RUN set -eu; \
    mkdir -p /opt/bkectl; \
    cd /opt/bkectl; \
    bvc clone sre/tce/srectl; \
    install -m 0755 /opt/bkectl/srectl/bkectl /usr/local/bin/bkectl; \
    rm -rf /opt/bkectl

RUN NPM_CONFIG_REGISTRY=http://bnpm.byted.org npm install -g \
      "@bytedance-dev/bytedcli@${BYTEDCLI_VERSION}" \
      "@larksuite/cli@${LARK_CLI_VERSION}" \
    && lark-cli --version \
    && bytedcli --version \
    && npm cache clean --force

USER node
RUN --network=none command -v bkectl && BKECTL_DISABLE_AUTO_UPDATE=1 bkectl version \
    && command -v bytedcli && bytedcli --version \
    && command -v lark-cli && lark-cli --version

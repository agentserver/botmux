# syntax=docker/dockerfile:1

# Temporary production hotfix: reuse the existing internal byted image and add
# only python3 while the normal GHCR base-layer pull is unavailable.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root
RUN sed -i 's|deb.debian.org|mirrors-sg.byted.cs.ac.cn|g; s|security.debian.org|mirrors-sg.byted.cs.ac.cn|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/* \
    && python3 --version

USER node
